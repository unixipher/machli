generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HubManager {
  id                      Int                @id @default(autoincrement())
  name                    String
  email                   String             @unique
  phone                   String             @unique
  token                   String             @unique
  address                 String
  geoLat                  Float
  geoLng                  Float
  createdAt               DateTime           @default(now())
  hubmanagerCategory      HubManagerCategory
  mainHubManagerId        Int?
  updatedAt               DateTime           @updatedAt
  farmId                  Int?
  driverManagers          DriverManager[]
  Farm                    Farm?              @relation(fields: [farmId], references: [id])
  mainHubManager          HubManager?        @relation("HubManagerHierarchy", fields: [mainHubManagerId], references: [id])
  intermediateHubManagers HubManager[]       @relation("HubManagerHierarchy")
  orders                  Order[]
  products                Product[]
  shops                   Shop[]
  vehicles                Vehicle[]
}

model DriverManager {
  id           Int                   @id @default(autoincrement())
  name         String
  email        String                @unique
  status       DriverManagerStatus
  phone        String                @unique
  hubmanagerId Int
  address      String
  geoLat       Float
  geoLng       Float
  token        String                @unique
  category     DriverManagerCategory
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  hubManager   HubManager            @relation(fields: [hubmanagerId], references: [id])
  vehicles     Vehicle[]
}

model Shop {
  id                           Int        @id @default(autoincrement())
  name                         String
  phone                        String     @unique
  hubmanagerId                 Int
  geoLat                       Float
  geoLng                       Float
  address                      String
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  avgBuySize                   Float
  orders                       Order[]
  Product_Product_shopIdToShop Product[]  @relation("Product_shopIdToShop")
  hubManager                   HubManager @relation(fields: [hubmanagerId], references: [id])
  Product_PreferredProducts    Product[]  @relation("PreferredProducts")
}

model Order {
  id           Int         @id @default(autoincrement())
  shopId       Int
  hubmanagerId Int
  metadata     Json?
  status       OrderStatus @default(created)
  deliveryDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hubManager   HubManager  @relation(fields: [hubmanagerId], references: [id])
  shop         Shop        @relation(fields: [shopId], references: [id])
  orderItems   OrderItem[]
  vehicle      Vehicle[]   @relation("OrderToVehicle")
}

model Vehicle {
  id              Int            @id @default(autoincrement())
  number          String         @unique
  model           String
  drivermanagerId Int?
  metadata        Json?
  status          VehicleStatus
  hubmanagerId    Int
  capacity        Float
  createdAt       DateTime       @default(now()) @db.Timestamp(6)
  updatedAt       DateTime       @updatedAt @db.Timestamp(6)
  driverManager   DriverManager? @relation(fields: [drivermanagerId], references: [id])
  hubManager      HubManager     @relation(fields: [hubmanagerId], references: [id])
  Order           Order[]        @relation("OrderToVehicle")

  @@map("vehicle")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId], name: "unique_order_product")
  @@map("OrderItem")
}

model Product {
  id                        Int         @id @default(autoincrement())
  title                     String
  description               String
  price                     Float
  hubmanagerId              Int
  metadata                  Json?
  createdAt                 DateTime    @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime    @updatedAt @db.Timestamp(6)
  quantity                  Int
  avgWeight                 Float
  shopId                    Int?
  orderItems                OrderItem[]
  hubManager                HubManager  @relation(fields: [hubmanagerId], references: [id])
  Shop_Product_shopIdToShop Shop?       @relation("Product_shopIdToShop", fields: [shopId], references: [id])
  Shop_PreferredProducts    Shop[]      @relation("PreferredProducts")

  @@map("Product")
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
  verified  Boolean  @default(false)

  @@map("OTP")
}

model Farm {
  id                  Int          @id @default(autoincrement())
  name                String
  farmSize            Float
  address             String
  geoLat              Float
  expectedHarvestDate DateTime
  harvestQuantity     Int
  ownerName           String
  ownerPhone          String
  metadata            Json
  ownerEmail          String
  geoLng              Float
  createdAt           DateTime     @default(now())
  updatedAt           DateTime
  HubManager          HubManager[]
}

enum DriverManagerCategory {
  main
  intermediate
}

enum HubManagerCategory {
  main
  intermediate
}

enum OrderStatus {
  created
  pending
  in_transit
  in_source
  in_hub
  delivered
  cancelled
}

enum VehicleStatus {
  occupied
  available
}

enum DriverManagerStatus {
  occupied
  available
}
